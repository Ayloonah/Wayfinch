  "fixed_sql": [
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NULL, \"due\" TEXT NULL, \"due_has_time\" INTEGER NOT NULL DEFAULT 0 CHECK (\"due_has_time\" IN (0, 1)), \"start\" TEXT NULL, \"end\" TEXT NULL, \"priority\" TEXT NOT NULL DEFAULT 'none', \"recurrence\" TEXT NULL, \"parent_id\" TEXT NULL REFERENCES items (id), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"done_at\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"ics_uid\" TEXT NULL, \"custom_reminders\" INTEGER NOT NULL DEFAULT 0 CHECK (\"custom_reminders\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, \"color\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "item_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_tags\" (\"item_id\" TEXT NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"tag_id\" TEXT NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"item_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"offset_minutes\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "import_backups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_backups\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"created_at\" TEXT NOT NULL, \"payload\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "items_parent_id",
      "sql": [
        {
          "dialect": "sqlite",
